<Window x:Class="MapEditor.App.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path x:Name="Glyph" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Top" Stretch="Uniform"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
            <TextBox x:Name="Message" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" IsTabStop="False"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>

        <!-- The button bar, set off like the footer of a Windows 11 dialog. -->
        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
