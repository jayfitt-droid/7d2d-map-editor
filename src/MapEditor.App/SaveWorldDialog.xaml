<Window x:Class="MapEditor.App.SaveWorldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save World As" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="World name" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Margin="0,4" Padding="2" TextChanged="Input_Changed" />

        <TextBlock Grid.Row="1" Text="Location" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LocationBox" Margin="0,4" Padding="2" TextChanged="Input_Changed" />
        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="8,4,0,4" Padding="8,0" Click="Browse_Click" />

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="InfoText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#555" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Width="90" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" Width="90" />
        </StackPanel>
    </Grid>
</Window>
