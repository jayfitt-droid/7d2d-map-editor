<Window x:Class="MapEditor.App.NewWorldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New World" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="0,4" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Margin" Value="0,4" />
            </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0" Text="Name" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Text="My World" />

        <TextBlock Grid.Row="1" Text="Size (metres)" />
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SizeBox" />

        <TextBlock Grid.Row="2" Text="Ground height (m)" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="BaseHeightBox" Text="40"
                 ToolTip="Starting ground height. Water sits at 30 m, so stay above that for dry land." />

        <TextBlock Grid.Row="3" Text="Roughness (m)" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="NoiseAmpBox" Text="12"
                 ToolTip="How far noise lifts or lowers the ground. 0 for a flat start." />

        <TextBlock Grid.Row="4" Text="Feature size (m)" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="NoiseScaleBox" Text="600"
                 ToolTip="Width of the rolling hills the noise makes." />

        <TextBlock Grid.Row="5" Text="Seed" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="SeedBox" />

        <TextBlock Grid.Row="6" Text="Biomes" />
        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="BiomeModeBox" SelectionChanged="BiomeMode_Changed" AutomationProperties.Name="Biomes">
            <ComboBoxItem Content="One biome" />
            <ComboBoxItem Content="All biomes (generated layout)" />
        </ComboBox>

        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="BiomeBox" DisplayMemberPath="Name" AutomationProperties.Name="Biome" />
        <StackPanel Grid.Row="7" Grid.Column="1" x:Name="LayoutPanel" Visibility="Collapsed">
            <ComboBox x:Name="LayoutBox" DisplayMemberPath="Label" AutomationProperties.Name="Biome layout"
                      ToolTip="Where each biome starts before it grows, as in the game's world generator" />
            <TextBlock Text="Share of the map" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
            <ItemsControl x:Name="SharesList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Stroke="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                     Fill="{Binding Color, Converter={StaticResource RgbToBrush}}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="90" Margin="0" TextTrimming="CharacterEllipsis" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Width="38" Margin="6,0,0,0" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="50" Value="{Binding Weight}" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                                    ToolTip="{Binding Weight}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Game defaults" HorizontalAlignment="Left" Margin="0,4,0,0" Click="BiomeDefaults_Click"
                    ToolTip="The layout and shares the game's world generator starts with" />
        </StackPanel>

        <TextBlock Grid.Row="8" Text="Edges" VerticalAlignment="Top" Margin="0,10,0,4" />
        <UniformGrid Grid.Row="8" Grid.Column="1" Columns="2">
            <DockPanel Margin="0,0,6,0">
                <TextBlock Text="N" Width="16" />
                <ComboBox x:Name="EdgeN" />
            </DockPanel>
            <DockPanel Margin="6,0,0,0">
                <TextBlock Text="E" Width="16" />
                <ComboBox x:Name="EdgeE" />
            </DockPanel>
            <DockPanel Margin="0,0,6,0">
                <TextBlock Text="S" Width="16" />
                <ComboBox x:Name="EdgeS" />
            </DockPanel>
            <DockPanel Margin="6,0,0,0">
                <TextBlock Text="W" Width="16" />
                <ComboBox x:Name="EdgeW" />
            </DockPanel>
        </UniformGrid>

        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Create" IsDefault="True" Width="90" Margin="0,0,8,0" Click="Create_Click" />
            <Button Content="Cancel" IsCancel="True" Width="90" />
        </StackPanel>
    </Grid>
</Window>
