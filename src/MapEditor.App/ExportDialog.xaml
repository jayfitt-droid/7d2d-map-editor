<Window x:Class="MapEditor.App.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MapEditor.App"
        Title="Export World" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Writes a world folder the game loads directly. Worlds in the game's GeneratedWorlds folder show up under New Game." />

        <Label Grid.Row="1" Content="_World name" Target="{Binding ElementName=NameBox}" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Margin="0,4" TextChanged="Input_Changed" />

        <Label Grid.Row="2" Content="_Location" Target="{Binding ElementName=LocationBox}" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="LocationBox" Margin="0,4" TextChanged="Input_Changed" />
        <Button Grid.Row="2" Grid.Column="2" Content="_Browse..." Margin="8,4,0,4" Click="Browse_Click" />

        <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,2,0,0"
                Content="Use the game's _GeneratedWorlds folder" Click="GameFolder_Click" />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" x:Name="InfoText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <TextBlock x:Name="IssuesHeader" FontWeight="SemiBold" />
            <ListBox x:Name="IssuesList" MaxHeight="220" Margin="0,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Validation results">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="20" FontWeight="Bold"
                                       Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ExportButton" Content="Export" IsDefault="True" MinWidth="110" Margin="0,0,8,0" Click="Export_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
