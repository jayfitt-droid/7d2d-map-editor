<Window x:Class="MapEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:MapEditor.App.Map"
        xmlns:local="clr-namespace:MapEditor.App"
        Title="7D2D Map Editor" Width="1400" Height="900"
        Background="#1E1F23">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D8DE" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8D0" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewWorldCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenWorldCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.RedoCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewWorldCommand}" Executed="NewWorld_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenWorldCommand}" Executed="OpenWorld_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveCommand}" Executed="Save_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="SaveAs_Executed" CanExecute="HasWorld_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="Undo_Executed" CanExecute="Undo_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="Redo_Executed" CanExecute="Redo_CanExecute" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New World..." InputGestureText="Ctrl+N" Command="{x:Static local:MainWindow.NewWorldCommand}" />
                <MenuItem Header="_Open World..." InputGestureText="Ctrl+O" Command="{x:Static local:MainWindow.OpenWorldCommand}" />
                <MenuItem Header="_Save World" InputGestureText="Ctrl+S" Command="{x:Static local:MainWindow.SaveCommand}" />
                <MenuItem Header="Save World _As..." InputGestureText="Ctrl+Shift+S" Command="{x:Static local:MainWindow.SaveAsCommand}" />
                <Separator />
                <MenuItem Header="_Import Heightmap..." Click="ImportHeightmap_Click" />
                <MenuItem Header="_Export Heightmap..." Click="ExportHeightmap_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoText}" InputGestureText="Ctrl+Z" Command="{x:Static local:MainWindow.UndoCommand}" />
                <MenuItem Header="{Binding RedoText}" InputGestureText="Ctrl+Y" Command="{x:Static local:MainWindow.RedoCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Fit World" InputGestureText="Home" Click="Fit_Click" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Game Folder..." Click="GameFolder_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#2A2B30" Foreground="#D0D0D8">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding ZoomText}" MinWidth="90" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding CursorText}" FontFamily="Consolas" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Left" Width="250" Background="#25262B" BorderBrush="#33343A" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,0,12,12">
                    <TextBlock Text="Tools" Style="{StaticResource PanelHeader}" />
                    <ListBox ItemsSource="{Binding Tools}" SelectedValuePath="Tool" SelectedValue="{Binding SelectedTool}"
                             DisplayMemberPath="Display" Background="#2D2E34" Foreground="#E0E0E6" BorderThickness="0" />

                    <StackPanel Visibility="{Binding HasRadius, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding BrushRadius, StringFormat=Radius: {0:0} m  ([ and ])}" />
                        <Slider Minimum="2" Maximum="800" Value="{Binding BrushRadius}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Shape" />
                        <ComboBox ItemsSource="{Binding BrushShapes}" SelectedItem="{Binding BrushShape}" />
                        <StackPanel Visibility="{Binding IsSquareBrush, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding BrushRotation, StringFormat=Rotation: {0:0}°  (Q and E)}" />
                            <Slider Minimum="0" Maximum="359" Value="{Binding BrushRotation}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRoadTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Surface" />
                        <ComboBox ItemsSource="{Binding RoadTypes}" SelectedItem="{Binding RoadType}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RoadWidth, StringFormat=Width: {0:0} m}" />
                        <Slider Minimum="3" Maximum="30" Value="{Binding RoadWidth}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <CheckBox Content="Grade the terrain under the road" IsChecked="{Binding RoadGrade}" />
                        <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Click to add points; double-click or Enter finishes, Backspace removes the last point, Esc cancels. Shift+drag erases roads using the radius above. RWG uses 18 m highways and 9 m country roads." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsBiomeTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Biome" />
                        <ComboBox ItemsSource="{Binding BiomeChoices}" SelectedItem="{Binding SelectedBiome}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" Margin="0,0,6,0" BorderBrush="#555" BorderThickness="1"
                                                Background="{Binding Color, Converter={StaticResource RgbToBrush}}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Biomes are stored in 8 m cells. Turn on the Biomes layer to see them." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRadiationTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Drag to add radiation, Shift+drag to erase. Radiation is stored in 32 m cells; RWG puts it along the map edge." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsWaterTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding WaterLevel, StringFormat=Water level: {0:0} m}" />
                        <Slider Minimum="1" Maximum="255" Value="{Binding WaterLevel}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Click low ground to flood everything connected below the level. Shift+click drains a body of water. Ctrl+click samples a level. The game's sea level is 30 m." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsBrushTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Edge" />
                        <ComboBox ItemsSource="{Binding BrushFalloffs}" SelectedItem="{Binding BrushFalloff}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding BrushStrength, StringFormat=Strength: {0:0.00}}" />
                        <Slider Minimum="0.01" Maximum="1" Value="{Binding BrushStrength}" />
                        <StackPanel Visibility="{Binding IsFlattenTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Target height (m)" />
                            <TextBox Text="{Binding FlattenHeight, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}" />
                            <CheckBox Content="Lock height (else picked at stroke start)" IsChecked="{Binding FlattenLocked}" />
                            <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Text="Ctrl+click samples the height under the cursor." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsNoiseTool, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding NoiseScale, StringFormat=Feature size: {0:0} m}" />
                            <Slider Minimum="4" Maximum="400" Value="{Binding NoiseScale}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsStampTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Stamp" />
                        <ComboBox ItemsSource="{Binding StampNames}" SelectedItem="{Binding SelectedStamp}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding StampSize, StringFormat=Size: {0:0} m  ([ and ])}" />
                        <Slider Minimum="32" Maximum="4000" Value="{Binding StampSize}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding StampRotation, StringFormat=Rotation: {0:0}°  (Q and E)}" />
                        <Slider Minimum="0" Maximum="359" Value="{Binding StampRotation}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding StampStrength, StringFormat=Strength: {0:0.00}}" />
                        <Slider Minimum="0.05" Maximum="1" Value="{Binding StampStrength}" />
                        <CheckBox Content="Additive (add height instead of blending)" IsChecked="{Binding StampAdditive}" />
                        <CheckBox Content="Fill water" IsChecked="{Binding StampWater}" />
                        <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap"
                                   Text="Game stamps blend toward 255 m (raise) or 0 m (carve) by their shape; lower the strength for gentler results." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPrefabTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PlacementText}" Foreground="#E0E0E6" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <CheckBox Content="Flatten the ground under it" IsChecked="{Binding PrefabFlatten}" Margin="0,8,0,3" />
                        <CheckBox Content="Add street furniture to street tiles" IsChecked="{Binding PrefabAddParts}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Search (name, tag or zone)" />
                        <TextBox Text="{Binding PrefabSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        <ComboBox ItemsSource="{Binding PrefabCategories}" SelectedItem="{Binding PrefabCategory}" Margin="0,4,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding PrefabTiers}" SelectedItem="{Binding PrefabTier}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding PrefabSizes}" SelectedItem="{Binding PrefabSize}" />
                        </Grid>
                        <TextBlock Text="{Binding PrefabResultsText}" Foreground="#8A8A96" FontSize="11" Margin="0,4,0,2" />
                        <ListBox ItemsSource="{Binding PrefabResults}" SelectedItem="{Binding SelectedPrefabInfo}" Height="220"
                                 Background="#2D2E34" Foreground="#E0E0E6" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Foreground="#8A8A96" Margin="6,0,0,0">
                                            <Run Text="{Binding Size.X, Mode=OneWay}" />×<Run Text="{Binding Size.Z, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Image Source="{Binding SelectedPrefabInfo.PreviewImagePath, Converter={StaticResource PreviewImage}}"
                               MaxHeight="160" Margin="0,6,0,0" Stretch="Uniform" />
                        <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Pick a prefab, then click the map to place it; Q and E turn it, Esc stops placing. With nothing picked, click a prefab to select it, drag to move it, Delete or Shift+click removes it. Street tiles snap to RWG's 150 m grid and match a neighbour's height; POIs dropped in a tile's lots (blue) face the street." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSpawnTool, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectionText}" Foreground="#E0E0E6" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Click to add a spawn point, drag one to move it, Q and E turn it, Delete or Shift+click removes it. The tick shows which way players face. RWG makes 12, in forest near a trader." />
                    </StackPanel>

                    <TextBlock Text="Layers" Style="{StaticResource PanelHeader}" />
                    <CheckBox Content="Dim the map (prefabs stand out)" IsChecked="{Binding DimMap}" />
                    <CheckBox Content="Hillshade" IsChecked="{Binding ShowHillshade}" />
                    <CheckBox Content="Biomes" IsChecked="{Binding ShowBiomes}" />
                    <CheckBox Content="Water" IsChecked="{Binding ShowWater}" />
                    <CheckBox Content="Roads" IsChecked="{Binding ShowRoads}" />
                    <CheckBox Content="Radiation" IsChecked="{Binding ShowRadiation}" />
                    <CheckBox Content="Prefabs (POIs)" IsChecked="{Binding ShowPrefabs}" />
                    <CheckBox Content="Spawn points" IsChecked="{Binding ShowSpawns}" />

                    <TextBlock Text="World" Style="{StaticResource PanelHeader}" />
                    <TextBlock Text="{Binding WorldSummary}" Foreground="#C8C8D0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />

                    <TextBlock Text="Game folder" Style="{StaticResource PanelHeader}" />
                    <TextBlock Text="{Binding GameFolderText}" Foreground="#C8C8D0" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <map:MapView x:Name="Map"
                         Layers="{Binding Layers}"
                         ShowPrefabs="{Binding ShowPrefabs}"
                         ShowSpawns="{Binding ShowSpawns}"
                         DimMap="{Binding DimMap}" />

            <!-- Info card for the prefab selected on the map. -->
            <Border Width="300" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#E62A2B30" BorderBrush="#50DCFF" BorderThickness="1" CornerRadius="4" Padding="10"
                    Visibility="{Binding ShowPrefabCard, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Background="Transparent" BorderThickness="0"
                                Foreground="#C8C8D0" ToolTip="Deselect (Esc)" Click="PrefabCardClose_Click" />
                        <TextBlock Text="{Binding SelectedMapPrefabName}" Foreground="White" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <Image Source="{Binding SelectedMapPrefab.PreviewImagePath, Converter={StaticResource PreviewImage}}"
                           MaxHeight="200" Margin="0,6,0,0" Stretch="Uniform" />
                    <TextBlock Text="{Binding SelectionText}" Foreground="#D8D8DE" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <Button Content="↺ Q" ToolTip="Turn a quarter counter-clockwise" Margin="0,0,3,0" Click="PrefabTurnLeft_Click" />
                        <Button Content="↻ E" ToolTip="Turn a quarter clockwise" Margin="0,0,3,0" Click="PrefabTurnRight_Click" />
                        <Button Content="▲ PgUp" ToolTip="Raise one block (the ground stays)" Margin="0,0,3,0" Click="PrefabRaise_Click" />
                        <Button Content="▼ PgDn" ToolTip="Lower one block (the ground stays)" Click="PrefabLower_Click" />
                    </UniformGrid>
                    <Button Margin="0,4,0,0" IsEnabled="{Binding CanReplace}" Click="PrefabReplace_Click"
                            ToolTip="Pick a prefab in the list, then swap it in here, facing the same way">
                        <TextBlock Text="{Binding ReplaceLabel}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Content="Delete  (Del)" Margin="0,4,0,0" Click="PrefabDelete_Click" />
                </StackPanel>
            </Border>
            <map:MiniMap x:Name="Overview" Width="200" Height="200" Margin="12"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            <TextBlock Text="Working..." Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
