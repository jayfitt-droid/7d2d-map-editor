<Window x:Class="MapEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="7D2D Map Editor" Width="1280" Height="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open World..." Click="OpenWorld_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="No world loaded" />
        </StatusBar>
        <Grid Background="#202226">
            <TextBlock x:Name="WorldSummary" Foreground="#C8C8D0" Margin="16"
                       FontFamily="Consolas" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</Window>
